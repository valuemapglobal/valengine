# ValEngine 环境变量配置示例
# 复制此文件为 .env 并根据需要修改

# ==================== MySQL 配置 ====================
MYSQL_ROOT_PASSWORD=risksmart123
MYSQL_PORT=3306

# ==================== Redis 配置 ====================
REDIS_PORT=6379

# ==================== Nacos 配置 ====================
NACOS_PORT=8848
NACOS_CONSOLE_PORT=8858
# Nacos 认证 Token (生产环境请更换为随机字符串，至少 64 字符)
NACOS_AUTH_TOKEN=SecretKey012345678901234567890123456789012345678901234567890123456789

# ==================== 服务端口 ====================
GATEWAY_PORT=8080
SYSTEM_PORT=8992
DECISION_PORT=8991
DATA_STATION_PORT=8990
WEB_PORT=80
