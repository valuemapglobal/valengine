# ==================== 数据库配置 ====================
# MySQL root 密码
MYSQL_ROOT_PASSWORD=risksmart123
# MySQL 端口
MYSQL_PORT=3306

# ==================== Redis 配置 ====================
# Redis 端口
REDIS_PORT=6379
# Redis 密码（可选，默认无密码）
# REDIS_PASSWORD=

# ==================== Nacos 配置 ====================
# Nacos 端口
NACOS_PORT=8848
# Nacos 鉴权 Token（生产环境请修改为强密码）
NACOS_AUTH_TOKEN=SecretKey012345678901234567890123456789012345678901234567

# ==================== 后端服务端口 ====================
# 决策引擎服务端口
DECISION_PORT=8991
# 数据中台服务端口
DATA_STATION_PORT=8990

# ==================== 前端服务端口 ====================
# Web 前端端口
WEB_PORT=80

# ==================== JVM 配置（可选）====================
# Java 内存配置
# JAVA_OPTS=-Xms512m -Xmx2048m -XX:MetaspaceSize=128m -XX:MaxMetaspaceSize=512m

# ==================== 日志级别（可选）====================
# LOGGING_LEVEL=INFO
